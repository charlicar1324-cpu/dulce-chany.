---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Dulce CHANY" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-amber-50/30 font-sans min-h-screen text-stone-800 antialiased">
		<slot />
	</body>
</html>