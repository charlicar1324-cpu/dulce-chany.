---
interface Props {
  nombre: string;
  descripcion: string;
  precio: number;
  categoria: string;
  imagen: string;
  popular?: boolean;
}

const { nombre, descripcion, precio, categoria, imagen, popular } = Astro.props;

const PHONE_NUMBER = "7293610746"; 
const mensajeWA = encodeURIComponent(`¡Hola! Me gustaría ordenar el postre: *${nombre}* ($${precio.toFixed(2)} MXN).`);
const linkWhatsApp = `https://wa.me/${PHONE_NUMBER}?text=${mensajeWA}`;
---

<div class="group relative bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-100 flex flex-col justify-between">
  <div>
    <div class="relative h-56 overflow-hidden bg-amber-100/50">
      <img 
        src={imagen} 
        alt={nombre} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        loading="lazy"
      />
      {popular && (
        <span class="absolute top-3 left-3 bg-rose-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
          ★ Favorito
        </span>
      )}
      <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-md text-amber-900 text-xs font-semibold px-2.5 py-1 rounded-lg border border-amber-200/50">
        {categoria}
      </span>
    </div>

    <div class="p-6">
      <div class="flex justify-between items-start gap-2 mb-2">
        <h3 class="text-xl font-bold text-stone-900 leading-snug group-hover:text-rose-600 transition-colors">
          {nombre}
        </h3>
        <span class="text-lg font-extrabold text-amber-900 whitespace-nowrap">
          ${precio.toFixed(2)}
        </span>
      </div>
      <p class="text-stone-600 text-sm line-clamp-3 leading-relaxed">
        {descripcion}
      </p>
    </div>
  </div>

  <div class="p-6 pt-0">
    <a 
      href={linkWhatsApp} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-sm font-bold rounded-2xl flex items-center justify-center gap-2 shadow-sm transition-all duration-200"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.157 4.228 4.301-1.129z"/>
      </svg>
      Pedir por WhatsApp :)
    </a>
  </div>
</div>