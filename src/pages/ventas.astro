---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. Obtenemos los productos activos desde Supabase
const { data: productos, error } = await supabase
  .from('productos')
  .select('*')
  .eq('disponible', true)
  .order('nombre');
---

<Layout title="Panel de Ventas | Dulce CHANY">
  <main class="max-w-4xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-800">Registrar Venta</h1>
      <a href="/" class="text-sm text-pink-600 hover:underline">← Volver al Menú</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Columna Izquierda: Selección de Productos -->
      <div class="md:col-span-2 bg-white p-4 rounded-xl shadow-md border border-gray-100">
        <h2 class="text-lg font-semibold mb-4 text-gray-700">Productos Disponibles</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {productos && productos.map((prod) => (
            <button
              class="btn-agregar flex justify-between items-center p-3 bg-pink-50 hover:bg-pink-100 border border-pink-200 rounded-lg text-left transition"
              data-id={prod.id}
              data-nombre={prod.nombre}
              data-precio={prod.precio}
            >
              <div>
                <p class="font-medium text-gray-800">{prod.nombre}</p>
                <p class="text-xs text-gray-500">${prod.precio} MXN</p>
              </div>
              <span class="text-pink-600 font-bold text-lg">+</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Columna Derecha: Resumen y Cobro -->
      <div class="bg-white p-4 rounded-xl shadow-md border border-gray-100 flex flex-col justify-between">
        <div>
          <h2 class="text-lg font-semibold mb-4 text-gray-700">Resumen del Pedido</h2>
          
          <ul id="lista-carrito" class="divide-y divide-gray-100 mb-4 max-h-60 overflow-y-auto">
            <li class="py-2 text-sm text-gray-400 italic text-center" id="carrito-vacio">No hay productos seleccionados</li>
          </ul>

          <div class="border-t pt-3 space-y-3">
            <div class="flex justify-between font-bold text-xl text-gray-800">
              <span>Total:</span>
              <span id="texto-total">$0.00</span>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Método de Pago</label>
              <select id="metodo-pago" class="w-full border border-gray-300 rounded-lg p-2 text-sm">
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta">Tarjeta</option>
              </select>
            </div>
          </div>
        </div>

        <button
          id="btn-cobrar"
          disabled
          class="mt-6 w-full bg-pink-600 hover:bg-pink-700 text-white font-bold py-3 px-4 rounded-lg shadow transition disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Confirmar y Registrar Venta
        </button>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // Definición del tipo explícito para evitar errores de TypeScript
  interface ItemCarrito {
    id: string;
    nombre: string;
    precio: number;
    cantidad: number;
  }

  let carrito: ItemCarrito[] = [];

  const listaCarrito = document.getElementById('lista-carrito') as HTMLElement;
  const carritoVacio = document.getElementById('carrito-vacio') as HTMLElement;
  const textoTotal = document.getElementById('texto-total') as HTMLElement;
  const btnCobrar = document.getElementById('btn-cobrar') as HTMLButtonElement;
  const selectMetodo = document.getElementById('metodo-pago') as HTMLSelectElement;

  // Escuchar clics en los botones de agregar producto
  document.querySelectorAll('.btn-agregar').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const nombre = btn.getAttribute('data-nombre') || '';
      const precio = parseFloat(btn.getAttribute('data-precio') || '0');

      const existe = carrito.find((item: ItemCarrito) => item.id === id);
      if (existe) {
        existe.cantidad += 1;
      } else {
        carrito.push({ id, nombre, precio, cantidad: 1 });
      }

      actualizarVista();
    });
  });

  function actualizarVista() {
    listaCarrito.innerHTML = '';

    if (carrito.length === 0) {
      listaCarrito.appendChild(carritoVacio);
      btnCobrar.disabled = true;
      textoTotal.textContent = '$0.00';
      return;
    }

    btnCobrar.disabled = false;
    let total = 0;

    carrito.forEach((item: ItemCarrito) => {
      const subtotal = item.precio * item.cantidad;
      total += subtotal;

      const li = document.createElement('li');
      li.className = 'py-2 flex justify-between items-center text-sm';
      li.innerHTML = `
        <div>
          <p class="font-medium text-gray-800">${item.nombre}</p>
          <p class="text-xs text-gray-500">${item.cantidad} x $${item.precio}</p>
        </div>
        <span class="font-semibold text-gray-700">$${subtotal.toFixed(2)}</span>
      `;
      listaCarrito.appendChild(li);
    });

    textoTotal.textContent = `$${total.toFixed(2)}`;
  }

  // Guardar la venta en Supabase al hacer clic
  btnCobrar?.addEventListener('click', async () => {
    btnCobrar.disabled = true;
    btnCobrar.textContent = 'Registrando...';

    const totalVenta = carrito.reduce((acc: number, item: ItemCarrito) => acc + item.precio * item.cantidad, 0);
    const metodoPago = selectMetodo.value;

    try {
      // 1. Insertar en la tabla 'ventas'
      const { data: venta, error: errorVenta } = await supabase
        .from('ventas')
        .insert([{ total: totalVenta, metodo_pago: metodoPago }])
        .select()
        .single();

      if (errorVenta) throw errorVenta;

      // 2. Insertar los detalles en 'detalle_ventas'
      const detalles = carrito.map((item: ItemCarrito) => ({
        venta_id: venta.id,
        producto_id: item.id,
        cantidad: item.cantidad,
        precio_unitario: item.precio,
      }));

      const { error: errorDetalle } = await supabase.from('detalle_ventas').insert(detalles);

      if (errorDetalle) throw errorDetalle;

      alert('¡Venta registrada con éxito!');
      carrito = [];
      actualizarVista();
    } catch (err: any) {
      alert('Error al registrar la venta: ' + err.message);
    } finally {
      btnCobrar.textContent = 'Confirmar y Registrar Venta';
    }
  });
</script>