---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Número de WhatsApp del negocio (con lada de México)
const TELEFONO_WHATSAPP = "7293610746"; // ¡Asegúrate de poner tu número real!

const { data: productos } = await supabase.from('productos').select('*');
---

<Layout title="Registro de Compra | Dulce CHANY">
  <!-- CSS para el Mapa Interactivo -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <main class="max-w-3xl mx-auto px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-800 font-serif">Registro de Compra</h1>
        <p class="text-sm text-gray-500">Agrega tus productos y confirma tu pedido</p>
      </div>
      <a href="/" class="text-pink-600 hover:text-pink-800 text-sm font-semibold flex items-center gap-1">
        ← Volver al Menú
      </a>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100 flex flex-col gap-6">
      
      <!-- 1. SELECTOR Y AGREGADOR DE PRODUCTOS MULTIPLES -->
      <div class="p-4 bg-pink-50 rounded-xl border border-pink-200">
        <h2 class="text-md font-bold text-pink-800 mb-3">1. Selecciona tus productos</h2>
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
          <div class="sm:col-span-7">
            <label for="select-producto" class="block text-xs font-semibold text-gray-700 mb-1">Producto</label>
            <select id="select-producto" class="w-full p-2.5 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:outline-none">
              <option value="" disabled selected>-- Elige un postre o antojito --</option>
              {productos?.map((p) => (
                <option value={p.nombre} data-precio={p.precio}>
                  {p.nombre} - ${p.precio.toFixed(2)}
                </option>
              ))}
            </select>
          </div>
          <div class="sm:col-span-3">
            <label for="input-cantidad" class="block text-xs font-semibold text-gray-700 mb-1">Cantidad</label>
            <input type="number" id="input-cantidad" min="1" value="1" class="w-full p-2.5 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pink-500 focus:outline-none" />
          </div>
          <div class="sm:col-span-2">
            <button type="button" id="btn-agregar" class="w-full bg-pink-600 hover:bg-pink-700 text-white font-bold py-2.5 px-3 rounded-lg text-sm transition-all shadow-sm">
              + Agregar
            </button>
          </div>
        </div>
      </div>

      <!-- TABLA / RESUMEN DEL PEDIDO -->
      <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Resumen de tu Pedido:</h3>
        <div class="border border-gray-200 rounded-xl overflow-hidden">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-gray-600 border-b border-gray-200">
              <tr>
                <th class="p-3">Producto</th>
                <th class="p-3 text-center">Cant.</th>
                <th class="p-3 text-right">Precio Unit.</th>
                <th class="p-3 text-right">Subtotal</th>
                <th class="p-3 text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="tabla-carrito" class="divide-y divide-gray-100">
              <tr id="fila-vacia">
                <td colspan="5" class="p-4 text-center text-gray-400 text-xs">No has agregado productos a tu compra aún.</td>
              </tr>
            </tbody>
          </table>
          <div class="bg-gray-50 p-3 flex justify-between items-center border-t border-gray-200 font-bold text-gray-800">
            <span>Total a Pagar:</span>
            <span id="total-pagar" class="text-lg text-pink-600">$0.00</span>
          </div>
        </div>
      </div>

      <!-- FORMULARIO DE DATOS DE ENVÍO Y PAGO -->
      <form id="form-compra" class="flex flex-col gap-5 border-t border-gray-100 pt-5">
        
        <!-- Nombre del Cliente -->
        <div>
          <label for="cliente" class="block text-sm font-semibold text-gray-700 mb-1">Tu Nombre Completo</label>
          <input type="text" id="cliente" name="cliente" placeholder="Ej. Juan Pérez" required class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none" />
        </div>

        <!-- Método de Pago -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Método de Pago</label>
          <div class="grid grid-cols-3 gap-3">
            <label class="flex items-center justify-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-pink-50 border-gray-300 has-[:checked]:border-pink-600 has-[:checked]:bg-pink-50">
              <input type="radio" name="metodo_pago" value="Efectivo" checked class="text-pink-600 focus:ring-pink-500" />
              <span class="text-xs sm:text-sm font-medium text-gray-800">💵 Efectivo</span>
            </label>
            <label class="flex items-center justify-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-pink-50 border-gray-300 has-[:checked]:border-pink-600 has-[:checked]:bg-pink-50">
              <input type="radio" name="metodo_pago" value="Tarjeta" class="text-pink-600 focus:ring-pink-500" />
              <span class="text-xs sm:text-sm font-medium text-gray-800">💳 Tarjeta</span>
            </label>
            <label class="flex items-center justify-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-pink-50 border-gray-300 has-[:checked]:border-pink-600 has-[:checked]:bg-pink-50">
              <input type="radio" name="metodo_pago" value="Transferencia" class="text-pink-600 focus:ring-pink-500" />
              <span class="text-xs sm:text-sm font-medium text-gray-800">📲 Transferencia</span>
            </label>
          </div>
        </div>

        <!-- Método de Entrega -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Opción de Entrega</label>
          <div class="grid grid-cols-2 gap-4">
            <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-pink-50 border-gray-300 has-[:checked]:border-pink-600 has-[:checked]:bg-pink-50">
              <input type="radio" name="tipo_entrega" value="Recoge el pedido" checked class="text-pink-600 focus:ring-pink-500" />
              <span class="text-sm font-medium text-gray-800">🏬 Recoger en tienda</span>
            </label>
            <label class="flex items-center gap-3 p-3 border rounded-xl cursor-pointer hover:bg-pink-50 border-gray-300 has-[:checked]:border-pink-600 has-[:checked]:bg-pink-50">
              <input type="radio" name="tipo_entrega" value="Entrega a domicilio" class="text-pink-600 focus:ring-pink-500" />
              <span class="text-sm font-medium text-gray-800">🛵 Entrega a domicilio</span>
            </label>
          </div>
        </div>

        <!-- Sección del Mapa Interactivo (Oculta por defecto) -->
        <div id="seccion-mapa" class="hidden flex-col gap-2 p-3 bg-gray-50 rounded-xl border border-gray-200">
          <label class="block text-sm font-semibold text-gray-700">Selecciona tu ubicación en el mapa:</label>
          <p class="text-xs text-gray-500">Haz clic en el mapa o arrastra el marcador para fijar la dirección exacta.</p>
          <div id="map" class="w-full h-60 rounded-lg border border-gray-300 z-0"></div>
          <input type="hidden" id="lat" name="lat" />
          <input type="hidden" id="lng" name="lng" />
        </div>

        <!-- Observaciones / Notas -->
        <div>
          <label for="notas" class="block text-sm font-semibold text-gray-700 mb-1">Notas o referencias adicionales (opcional)</label>
          <textarea id="notas" name="notas" rows="2" placeholder="Ej. Cambio para billete de $500, o referencias de la casa..." class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none text-sm"></textarea>
        </div>

        <!-- Botón de Envío -->
        <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 text-base">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Confirmar y Enviar Pedido por WhatsApp</span>
        </button>
      </form>
    </div>
  </main>

  <!-- Script de Lógica Interactiva -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline>
    let carrito = [];
    let map, marker;
    const defaultLat = 19.2925;
    const defaultLng = -99.6569;

    const selectProducto = document.getElementById('select-producto');
    const inputCantidad = document.getElementById('input-cantidad');
    const btnAgregar = document.getElementById('btn-agregar');
    const tablaCarrito = document.getElementById('tabla-carrito');
    const totalPagarElem = document.getElementById('total-pagar');

    // 1. LÓGICA DE AGREGAR MÚLTIPLES PRODUCTOS
    btnAgregar.addEventListener('click', () => {
      const option = selectProducto.options[selectProducto.selectedIndex];
      if (!option || !selectProducto.value) {
        alert('Por favor selecciona un producto');
        return;
      }

      const nombre = option.value;
      const precio = parseFloat(option.getAttribute('data-precio'));
      const cantidad = parseInt(inputCantidad.value) || 1;

      // Verificar si ya existe en la lista
      const existente = carrito.find(p => p.nombre === nombre);
      if (existente) {
        existente.cantidad += cantidad;
        existente.subtotal = existente.cantidad * existente.precio;
      } else {
        carrito.push({
          nombre,
          precio,
          cantidad,
          subtotal: precio * cantidad
        });
      }

      renderCarrito();
      selectProducto.selectedIndex = 0;
      inputCantidad.value = 1;
    });

    function renderCarrito() {
      if (carrito.length === 0) {
        tablaCarrito.innerHTML = `
          <tr id="fila-vacia">
            <td colspan="5" class="p-4 text-center text-gray-400 text-xs">No has agregado productos a tu compra aún.</td>
          </tr>`;
        totalPagarElem.textContent = '$0.00';
        return;
      }

      tablaCarrito.innerHTML = '';
      let total = 0;

      carrito.forEach((item, index) => {
        total += item.subtotal;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="p-3 font-medium text-gray-800">${item.nombre}</td>
          <td class="p-3 text-center">${item.cantidad}</td>
          <td class="p-3 text-right text-gray-600">$${item.precio.toFixed(2)}</td>
          <td class="p-3 text-right font-semibold text-gray-800">$${item.subtotal.toFixed(2)}</td>
          <td class="p-3 text-center">
            <button type="button" onclick="eliminarProducto(${index})" class="text-red-500 hover:text-red-700 font-bold text-xs">✕ Quitar</button>
          </td>
        `;
        tablaCarrito.appendChild(tr);
      });

      totalPagarElem.textContent = `$${total.toFixed(2)}`;
    }

    window.eliminarProducto = function(index) {
      carrito.splice(index, 1);
      renderCarrito();
    };

    // 2. LÓGICA DEL MAPA
    const radiosEntrega = document.querySelectorAll('input[name="tipo_entrega"]');
    const seccionMapa = document.getElementById('seccion-mapa');

    radiosEntrega.forEach(radio => {
      radio.addEventListener('change', (e) => {
        if (e.target.value === 'Entrega a domicilio') {
          seccionMapa.classList.remove('hidden');
          seccionMapa.classList.add('flex');
          if (!map) initMap();
        } else {
          seccionMapa.classList.add('hidden');
          seccionMapa.classList.remove('flex');
        }
      });
    });

    function initMap() {
      map = L.map('map').setView([defaultLat, defaultLng], 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
      }).addTo(map);

      marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);
      
      document.getElementById('lat').value = defaultLat;
      document.getElementById('lng').value = defaultLng;

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition((pos) => {
          const { latitude, longitude } = pos.coords;
          map.setView([latitude, longitude], 16);
          marker.setLatLng([latitude, longitude]);
          document.getElementById('lat').value = latitude;
          document.getElementById('lng').value = longitude;
        });
      }

      marker.on('dragend', function () {
        const pos = marker.getLatLng();
        document.getElementById('lat').value = pos.lat;
        document.getElementById('lng').value = pos.lng;
      });

      map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        document.getElementById('lat').value = e.latlng.lat;
        document.getElementById('lng').value = e.latlng.lng;
      });
    }

    // 3. ENVÍO DEL PEDIDO
    document.getElementById('form-compra').addEventListener('submit', function (e) {
      e.preventDefault();

      if (carrito.length === 0) {
        alert('Por favor agrega al menos un producto a tu lista de compra antes de continuar.');
        return;
      }

      const cliente = document.getElementById('cliente').value;
      const metodoPago = document.querySelector('input[name="metodo_pago"]:checked').value;
      const tipoEntrega = document.querySelector('input[name="tipo_entrega"]:checked').value;
      const notas = document.getElementById('notas').value;

      let resumenProductos = "";
      let total = 0;

      carrito.forEach(p => {
        resumenProductos += `  • ${p.cantidad}x ${p.nombre} ($${p.subtotal.toFixed(2)})\n`;
        total += p.subtotal;
      });

      let mapsUrl = "";
      if (tipoEntrega === 'Entrega a domicilio') {
        const lat = document.getElementById('lat').value;
        const lng = document.getElementById('lng').value;
        mapsUrl = `https://www.google.com/maps?q=${lat},${lng}`;
      }

      // Construcción del mensaje para WhatsApp
      const mensaje = `*¡Nuevo Pedido - Dulce CHANY!* 🧁\n\n` +
                      `👤 *Cliente:* ${cliente}\n\n` +
                      `🛒 *Productos:* \n${resumenProductos}\n` +
                      `💰 *Total:* $${total.toFixed(2)}\n` +
                      `💳 *Método de Pago:* ${metodoPago}\n` +
                      `🛵 *Entrega:* ${tipoEntrega}\n` +
                      (tipoEntrega === 'Entrega a domicilio' ? `📍 *Ubicación Mapa:* ${mapsUrl}\n` : '') +
                      (notas ? `📝 *Notas:* ${notas}\n` : '') +
                      `\n¡Hola! Me gustaría confirmar mi compra.`;

      const telefono = "7293610746"; // Reemplazar número
      const whatsappUrl = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;

      window.open(whatsappUrl, '_blank');
    });
  </script>
</Layout>